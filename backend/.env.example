
# LLM配置 (从HelloAgents继承,如需覆盖可在此配置)
# 模型名称
LLM_MODEL_ID=your-model-name

# API密钥
LLM_API_KEY=your-api-key-here

# 服务地址
LLM_BASE_URL=your-api-base-url

# 超时时间（可选，默认60秒；行程生成建议不低于300秒）
LLM_TIMEOUT=300

# 服务器配置
HOST=0.0.0.0
PORT=8000

# CORS配置
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 日志级别
LOG_LEVEL=INFO

# Unsplash API Credentials
UNSPLASH_ACCESS_KEY=""
UNSPLASH_SECRET_KEY=""

# 高德地图API配置
AMAP_API_KEY=your_amap_api_key_here
AMAP_SECURITY_KEY=your_amap_security_key_here

# 数据库配置 默认SQLite,可替换为postgresql+psycopg2://user:password@localhost:5432/trip_planner
DATABASE_URL=sqlite:///./trip_planner.db

# Redis配置 未启动Redis时后端会自动跳过缓存
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# AI行程缓存与限流
AI_PLAN_CACHE_TTL_SECONDS=1800
PLAN_RATE_LIMIT_COUNT=3
PLAN_RATE_LIMIT_WINDOW_SECONDS=60

# 联网搜索(可选,未配置TAVILY_API_KEY时自动跳过)
TAVILY_API_KEY=
# 联网搜索默认模式: off/auto/on
WEB_SEARCH_DEFAULT_MODE=auto

# 行程审核与候选择优
MAX_REVIEW_ROUNDS=1
PLAN_CANDIDATE_MIN_SCORE=75
PLAN_CANDIDATE_COUNT=2

# JWT配置 请在生产环境改成随机长字符串
JWT_SECRET_KEY=please-change-this-secret-key
JWT_EXPIRE_MINUTES=10080